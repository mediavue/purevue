---
import { Image } from "astro:assets";
import logoMark from "../assets/images/logo-mark.png";
import { business } from "../data/business";

interface Props {
  /** Show the big blue "Ready for clear windows?" panel above the footer */
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
---

<section class="closing">
  <div class="wrap">
    {showCta && (
      <div class="cta-panel">
        <div>
          <h2>Ready for clear windows?</h2>
          <a class="phone" href={business.phoneLink}>{business.phoneDisplay}</a>
        </div>
        <div class="side">
          <p>Call, text or email for a free quote. Already a customer? Set up Direct Debit in a minute.</p>
          <div class="buttons">
            <a class="btn btn-white" href="/#quote">Get a quote</a>
            <a class="btn btn-glass" href={business.directDebit} rel="noopener">Set up Direct Debit</a>
          </div>
        </div>
      </div>
    )}

    <footer>
      <div>
        <Image src={logoMark} alt="PureVue" width={104} />
        <p>Pure water window cleaning for homes and businesses across north Essex and south Suffolk.</p>
      </div>
      <div>
        <h3>Contact</h3>
        <ul>
          <li><a href={business.phoneLink}>{business.phoneDisplay}</a></li>
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li><a href={business.facebook} rel="noopener">Facebook</a></li>
        </ul>
      </div>
      <div>
        <h3>Customers</h3>
        <ul>
          <li><a href={business.directDebit} rel="noopener">Set up Direct Debit</a></li>
          <li><a href="/#quote">Get a quote</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
        </ul>
      </div>
      <div class="legal">
        <span>© {year} {business.name}</span>
        <span>Website by MediaVue</span>
      </div>
    </footer>
  </div>
</section>

<style>
  .closing { background: var(--navy); color: #fff; padding-block: clamp(4.5rem, 10vw, 7rem) 2.5rem; }
  .cta-panel {
    border-radius: 2rem; padding: clamp(2rem, 6vw, 4rem); margin-bottom: 4rem;
    background: radial-gradient(40rem 20rem at 100% 0%, rgb(31 176 220 / 0.45), transparent 60%), linear-gradient(135deg, var(--royal), #0b3fd6);
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; align-items: end;
  }
  .cta-panel h2 { font-size: clamp(2.2rem, 1.3rem + 3.6vw, 4.2rem); font-weight: 800; }
  .phone { display: block; margin-top: 1rem; font: 750 clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem)/1 var(--f-display); letter-spacing: -0.02em; text-decoration: none; font-variant-numeric: tabular-nums; }
  .side { display: grid; gap: 0.8rem; justify-items: start; }
  .side p { color: rgb(255 255 255 / 0.85); }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (max-width: 52rem) { .cta-panel { grid-template-columns: minmax(0, 1fr); } }

  footer { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2rem; color: rgb(255 255 255 / 0.7); font-size: 0.95rem; }
  footer img { height: 2.4rem; width: auto; margin-bottom: 1rem; }
  footer h3 { font: 650 0.78rem/1 var(--f-body); letter-spacing: 0.14em; text-transform: uppercase; color: #fff; margin-bottom: 1rem; }
  footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  footer a { text-decoration: none; }
  footer a:hover { color: #fff; }
  .legal { grid-column: 1 / -1; padding-top: 1.75rem; border-top: 1px solid var(--glass-line); font-size: 0.85rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  @media (max-width: 44rem) {
    footer { grid-template-columns: 1fr; }
    .closing { padding-bottom: 6rem; } /* room for the phone action bar */
  }
</style>
