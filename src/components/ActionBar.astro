---
import { business } from "../data/business";
---

<!-- Call / quote buttons that stay at the bottom of the screen on phones -->
<div class="action-bar">
  <a class="btn btn-glass" href={business.phoneLink}>Call</a>
  <a class="btn btn-royal" href="/#quote">Free quote</a>
</div>

<style>
  .action-bar { display: none; }
  @media (max-width: 44rem) {
    .action-bar {
      position: fixed; inset: auto 0 0; z-index: 50;
      display: grid; grid-template-columns: 1fr 1.4fr; gap: 0.5rem;
      padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
      background: rgb(7 19 48 / 0.88); backdrop-filter: blur(16px);
      border-top: 1px solid var(--glass-line);
    }
  }
</style>
