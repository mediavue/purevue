---
import { Picture } from "astro:assets";
import houseFront from "../assets/images/house-front.jpg";
---

<section class="section guarantee">
  <div class="wrap">
    <figure>
      <Picture
        src={houseFront}
        formats={["avif", "webp"]}
        widths={[600, 1000, 1600]}
        sizes="(max-width: 48rem) 100vw, 40rem"
        alt="Red-brick detached house with gleaming white windows"
      />
      <div class="badge"><div class="big">100%</div><small>Re-clean guarantee</small></div>
    </figure>
    <div>
      <span class="label">Our guarantee</span>
      <h2>Not happy? We'll come back and clean again, free.</h2>
      <p>If any window isn't up to standard, tell us. We'll return and put it right at no cost.</p>
      <a class="btn btn-royal" href="#quote">Book your first clean</a>
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  figure { position: relative; margin: 0; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 16 / 11; max-width: 100%; }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .badge {
    position: absolute; left: 1.25rem; bottom: 1.25rem;
    padding: 1rem 1.4rem 1.1rem; border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.9); backdrop-filter: blur(12px);
    color: var(--navy); box-shadow: 0 20px 40px -20px rgb(7 19 48 / 0.5);
  }
  .badge small { display: block; font: 600 0.8rem/1.2 var(--f-body); color: #4f5d7a; margin-top: 0.35rem; }
  .big {
    font: 800 clamp(3.2rem, 2.4rem + 3vw, 4.6rem)/0.85 var(--f-display); letter-spacing: -0.06em;
    background: linear-gradient(160deg, var(--cyan), var(--royal));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); font-weight: 780; margin-top: 1rem; }
  p { color: var(--muted); font-size: 1.15rem; margin-top: 1rem; max-width: 34rem; }
  .btn { margin-top: 2rem; }
  @media (max-width: 48rem) { .wrap { grid-template-columns: minmax(0, 1fr); } }
</style>
